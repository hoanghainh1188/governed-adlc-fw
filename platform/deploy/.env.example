# Environment for platform/deploy/docker-compose.yml (task A02).
#
# Do NOT copy this file by hand. Run:
#   platform/deploy/scripts/init-env.sh
# It writes platform/deploy/.env (mode 600) with a random value for every CHANGEME.
# .env is ignored by Git. Never commit real values.
#
# CHANGEME values are placeholders only; Compose refuses to start while a secret is missing.

# --- General --------------------------------------------------------------
COMPOSE_PROJECT_NAME=sdlc
# Host address for published ports. Keep 127.0.0.1: the server accepts no inbound
# internet connections (D-03 section 9).
SDLC_BIND_ADDR=127.0.0.1
# Subnet of the Compose network. OpenBao AppRole secret IDs only work from this subnet
# (design/ADR-M19). Change it only if it clashes with another network on the host.
SDLC_NETWORK_SUBNET=172.30.0.0/24
# Gateway of that network: an address inside the subnet. It is left out of the OpenBao AppRole
# CIDRs, because host processes reach containers from it (design/QUESTIONS.md #37).
SDLC_NETWORK_GATEWAY=172.30.0.1

# --- OpenBao TLS (A10, design/ADR-M63, runbook T11 section 3c) -----------------
# Absolute path of the folder with ca.pem, server.pem and server-key.pem for OpenBao's listener
# 8200, outside the repository's tracked files. init-env.sh fills it in with a throw-away CA
# (openbao/tls.sh dev); on the server the operator issues the certificate with the company CA
# (openbao/tls.sh ca, then server). Never put the CA's private key in this folder.
SDLC_OPENBAO_TLS_DIR=

# --- Backups (A10, design/ADR-M63, runbook T11 section 6) ----------------------
# pnpm backup writes one encrypted folder per run into SDLC_BACKUP_DIR: an absolute path outside the
# repository, for example a mounted NAS or an external disk. SDLC_BACKUP_AGE_RECIPIENTS names a
# file with the age PUBLIC key; the private key stays offline with the OpenBao key shares.
# SDLC_BACKUP_KEEP: how many backups to keep (default 14).
SDLC_BACKUP_DIR=
SDLC_BACKUP_AGE_RECIPIENTS=
SDLC_BACKUP_KEEP=14
# pnpm doctor and pnpm alerts (O03, design/ADR-M101): the newest backup is a warning after
# SDLC_BACKUP_WARN_HOURS (default 26) and a failure after SDLC_BACKUP_FAIL_HOURS (default 50).
SDLC_BACKUP_WARN_HOURS=26
SDLC_BACKUP_FAIL_HOURS=50
# pnpm doctor and pnpm alerts (O05, design/ADR-M102): warn this many days before an AppRole secret
# ID ends (90 days). Renew them all with pnpm openbao:bootstrap rotate-credentials.
SDLC_APPROLE_WARN_DAYS=14
# pnpm doctor and pnpm alerts (O04, design/ADR-M103): an append-only table this large, in GiB, is a
# warning: time to plan its monthly partitions (platform/deploy/README.md, Database growth).
SDLC_DB_TABLE_WARN_GB=20

# --- Alerts (O03, design/ADR-M101, platform/deploy/README.md "Alerts") ---------
# pnpm alerts runs the checks of pnpm doctor and sends what changed; the server's timer runs it
# (platform/deploy/alerts/sdlc-alerts.timer). At least one channel:
# SDLC_ALERT_WEBHOOK_FILE: a file (mode 600, outside the repository) that holds the webhook URL
#   alone; never put the URL here, it holds a token. SDLC_ALERT_WEBHOOK_FORMAT: text (Slack,
#   Google Chat, Mattermost, Rocket.Chat: {"text": ...}) or json.
# SDLC_ALERT_EMAIL_TO: addresses, comma-separated, sent through the server's sendmail
#   (SDLC_ALERT_SENDMAIL, default /usr/sbin/sendmail); SDLC_ALERT_EMAIL_FROM is optional.
# SDLC_ALERT_REMIND_HOURS: a problem that stays is sent again after this many hours (default 24).
# SDLC_ALERT_HOST_NAME: the name in each message (default: the machine's name).
# SDLC_ALERT_STATE_FILE: what was sent (default: alerts-state.json next to this file).
SDLC_ALERT_WEBHOOK_FILE=
SDLC_ALERT_WEBHOOK_FORMAT=text
SDLC_ALERT_EMAIL_TO=
SDLC_ALERT_EMAIL_FROM=
SDLC_ALERT_SENDMAIL=
SDLC_ALERT_REMIND_HOURS=24
SDLC_ALERT_HOST_NAME=
SDLC_ALERT_STATE_FILE=

# --- Host ports -------------------------------------------------------------
POSTGRES_HOST_PORT=5432
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8080
LITELLM_HOST_PORT=4000
SEAWEEDFS_S3_HOST_PORT=8333
LANGFUSE_HOST_PORT=3000
# REST API (profile platform, B03). 8080 is taken by the Temporal UI.
SDLC_API_HOST_PORT=8090
# Dashboard sign-in with GitHub (U05, ADR-M73 §2.2): `off` or `github`. With `github`, set the
# origin people open the dashboard at (http:// only on localhost, never 127.0.0.1) and store the
# GitHub App's client secret: pnpm openbao:bootstrap api-github-oauth-credentials (runbook T11 §5n).
SDLC_API_WEB_SIGNIN=off
SDLC_API_PUBLIC_ORIGIN=
# Actions in the dashboard (U06, ADR-M73 §2.3): `off` (default) or `on`. `on` needs the GitHub
# sign-in above; people then add a passkey and confirm each decision with it.
SDLC_API_DASHBOARD_ACTIONS=off
# --- Team access (profile access, V09, design/ADR-M67; README "Team access") ----------------
# Off unless the profile access is started (up.sh ... platform access, which checks these first).
# The LAN address of this machine the proxy listens on; empty: the profile refuses to start (the
# fallback in the compose file is 127.0.0.1, never the LAN). 0.0.0.0 is allowed, with a warning.
SDLC_ACCESS_BIND_ADDR=
SDLC_ACCESS_HOST_PORT=8443
# The DNS name people open (never an IP address: passkeys refuse it) and, optionally, IPv4
# addresses for the CLI, space-separated. Both must be in the certificate.
SDLC_ACCESS_HOSTNAME=
SDLC_ACCESS_IPS=
# Absolute path of the folder with ca.pem, server.pem and server-key.pem for the proxy. Test
# machine: pnpm access:tls dev; server: access/tls.sh import or server (runbook T11 section 3d),
# a folder outside the repository. Never a CA key in this folder.
SDLC_ACCESS_TLS_DIR=
# The small network shared by the proxy and the api only (never the network above). Change it
# only if it clashes with another network on the host: the proxy's address must stay inside the
# subnet and outside the allocation range, and SDLC_API_TRUSTED_PROXY must equal it.
SDLC_ACCESS_NETWORK_SUBNET=172.30.1.0/29
SDLC_ACCESS_NETWORK_IP_RANGE=172.30.1.0/30
SDLC_ACCESS_PROXY_IP=172.30.1.6
# The api trusts X-Forwarded-For only from this address. Empty unless the profile access runs;
# then the proxy's address above.
SDLC_API_TRUSTED_PROXY=
# Per client address: requests a second (and burst), sign-in requests a minute (and burst),
# connections at the same time. Over a limit: 429.
SDLC_ACCESS_RATE_PER_SECOND=10
SDLC_ACCESS_RATE_BURST=40
SDLC_ACCESS_SIGNIN_RATE_PER_MINUTE=30
SDLC_ACCESS_SIGNIN_BURST=10
SDLC_ACCESS_CONN_PER_ADDR=20
# Local registry for sandbox images (profile sandbox, C04). Always 127.0.0.1; no authentication.
# Not 5000: macOS uses it for AirPlay.
SDLC_REGISTRY_HOST_PORT=5050

# --- Self-hosted model (profiles models-local and models-local-pull, L01, design/ADR-M71) ----
# Off unless the profile models-local is started (a server with an NVIDIA GPU only; README
# "Self-hosted model"). The model: a public Hugging Face repository and a commit of it (a commit
# hash is better than main). pnpm models-local:pull downloads exactly this into the volume
# vllm-models; vllm never downloads anything itself. Change both, pull again, then restart vllm.
SDLC_VLLM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
SDLC_VLLM_MODEL_REVISION=main
# The name LiteLLM and the agent register see (model_ref). Carry the model version in it; equal to
# the field `model` of kv/litellm/providers/vllm (runbook T11 section 5d.1).
SDLC_VLLM_SERVED_NAME=qwen3-coder-30b-a3b-instruct
# At most this many requests at the same time: vLLM --max-num-seqs and LiteLLM's
# max_parallel_requests (a request over the limit is refused, not queued).
SDLC_VLLM_MAX_NUM_SEQS=4
# Context length, the share of GPU memory vLLM may use, the GPUs it uses (also its tensor
# parallel size), the tool-call parser of the model family, and the shared memory size.
SDLC_VLLM_MAX_MODEL_LEN=32768
SDLC_VLLM_GPU_MEMORY_UTILIZATION=0.90
SDLC_VLLM_GPU_COUNT=1
SDLC_VLLM_TOOL_PARSER=qwen3_coder
SDLC_VLLM_SHM_SIZE=8gb

# --- Runner and sandboxes (profile sandbox, C04, design/ADR-M25) -------------------
# Group of the Docker socket; init-env.sh fills it in (Linux: group of /var/run/docker.sock,
# Docker Desktop: 0). The socket proxy needs it to read the socket.
SDLC_DOCKER_GID=
# Concurrent sandboxes on this host (D-03 section 10.1: 1-2). Each reserves up to 2 GiB.
SDLC_RUNNER_MAX_SANDBOXES=1
# Evaluation runs (L04): the most sandboxes they may hold at the same time. They use free slots
# only and give a slot back to a real run that waits. Never above the line before; 0 turns them off.
SDLC_RUNNER_MAX_EVAL_SANDBOXES=1
# How often the runner removes the objects of runs it does not hold, in seconds.
SDLC_RUNNER_SWEEP_INTERVAL_SECONDS=300

# --- The runner on its own Docker Engine (O01, design/ADR-M91; README "The runner on its own
# Docker Engine"). Empty on a developer machine and a trial: the runner shares this Engine.
# The link address: the services the runner host needs are published on it only (overlay
# docker-compose.runner-link.yml); the profile sandbox is then refused on this host.
SDLC_RUNNER_LINK_ADDR=
# The runner host's address as OpenBao sees it, one IPv4 block (a VM: its WireGuard address/32;
# the same server: the link address/32). Only the AppRole "runner" accepts it; run
# `pnpm openbao:bootstrap configure` again after a change.
SDLC_RUNNER_SOURCE_CIDR=
# The runner's own Engine, for `pnpm openbao:bootstrap runner-credentials`: ssh://<user>@<vm> or
# unix:///run/user/<uid of sdlc-runner>/docker.sock.
SDLC_RUNNER_DOCKER_HOST=

# --- PostgreSQL (one database and one owner role per component) -----------------
POSTGRES_SUPERUSER_PASSWORD=CHANGEME
PLATFORM_DB_PASSWORD=CHANGEME
# Application role of the platform database: no DELETE, no DDL (design/ADR-M09).
PLATFORM_APP_DB_PASSWORD=CHANGEME
TEMPORAL_DB_PASSWORD=CHANGEME
LITELLM_DB_PASSWORD=CHANGEME
LANGFUSE_DB_PASSWORD=CHANGEME
# The superuser of knowledge-db, the index of project documents (profile knowledge, X04 PR 3a,
# design/ADR-M89). The worker's role `knowledge` gets its password from
# `pnpm openbao:bootstrap worker-knowledge-credentials` (in OpenBao), never from this file.
KNOWLEDGE_DB_SUPERUSER_PASSWORD=CHANGEME

# --- Temporal ------------------------------------------------------------------
TEMPORAL_NAMESPACE=default
# Retention of CLOSED workflows in Temporal. Unrelated to audit retention (platform DB).
TEMPORAL_NAMESPACE_RETENTION=30d

# --- Valkey (shared by LiteLLM and Langfuse) ------------------------------------
VALKEY_PASSWORD=CHANGEME
# Hard memory limit. Policy is noeviction: when full, writes fail for both
# Langfuse and LiteLLM (design/ADR-M17). Watch usage; raise if needed.
VALKEY_MAXMEMORY=256mb

# --- LiteLLM -------------------------------------------------------------------
# DEVELOPMENT WITHOUT THE PROFILE "models" ONLY. With the profile "models" (always on the server)
# the master key comes from OpenBao kv/cost-controller/litellm-master-key and the salt key from
# kv/litellm/salt-key (design/ADR-M24, runbook T11). On the server, leave both empty.
# Model provider keys never go here: they live in OpenBao kv/litellm/providers/<provider>.
# Must start with "sk-".
LITELLM_MASTER_KEY=CHANGEME
# Encrypts credentials stored in the LiteLLM database. Never change it after first start.
LITELLM_SALT_KEY=CHANGEME
# Test only: another template for the LiteLLM sidecar (live tests use a stub model). Keep empty.
SDLC_LITELLM_TEMPLATE=

# --- SeaweedFS (S3 API) --------------------------------------------------------
SEAWEEDFS_S3_ACCESS_KEY=CHANGEME
SEAWEEDFS_S3_SECRET_KEY=CHANGEME
SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=1024

# --- Observability profile: ClickHouse + Langfuse -------------------------------
CLICKHOUSE_PASSWORD=CHANGEME
LANGFUSE_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
# 64 hex characters (openssl rand -hex 32).
LANGFUSE_ENCRYPTION_KEY=CHANGEME
# Headless initialisation: the only Langfuse account (open sign-up is disabled).
LANGFUSE_INIT_ORG_ID=sdlc
LANGFUSE_INIT_ORG_NAME="Agentic SDLC"
LANGFUSE_INIT_PROJECT_ID=sdlc-platform
LANGFUSE_INIT_PROJECT_NAME="Agentic SDLC platform"
# Must start with "pk-lf-" and "sk-lf-".
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@sdlc.invalid
LANGFUSE_INIT_USER_NAME="Platform admin"
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
# Tracing (A08, design/ADR-M35): OTLP endpoint of the platform processes and LiteLLM. Leave empty:
# up.sh sets http://otel-collector:4318 when the profile observability is in the same call. The
# collector sends to Langfuse with the project key above (the only service that holds it).
SDLC_OTEL_ENDPOINT=

# --- Evidence retention (E05, design/ADR-M51) ------------------------------------
# The worker's retention loop: `report` counts what would be purged and deletes nothing (logs
# `worker.retention_pass`, `pnpm adlc ops retention report`); `purge` deletes evidence files past
# `retention.evidence_retention_days` (≥ 180) and of archived projects. Deleting cannot be undone:
# keep `report` until the report shows what you expect (runbook T11 §5j).
SDLC_WORKER_RETENTION_MODE=report
# Days after a project is archived before its evidence is purged (a mistaken archive is noticed).
SDLC_WORKER_RETENTION_ARCHIVE_GRACE_DAYS=7
# Days after client_data.deletion_approved before the worker may purge tier-1 content (H03b, ADR-M97).
SDLC_CLIENT_DELETION_GRACE_DAYS=14

# --- Housekeeping of the dashboard's sessions (O04, design/ADR-M103) -------------
# The retention loop removes ended web sessions after SDLC_WORKER_SESSION_KEEP_DAYS (default 30,
# at least 7) and used or expired passkey challenges after SDLC_WORKER_CHALLENGE_KEEP_HOURS
# (default 24, at least 1). They hold hashes and times only. `report` counts, `off` stops it.
SDLC_WORKER_HOUSEKEEPING_MODE=remove
SDLC_WORKER_SESSION_KEEP_DAYS=30
SDLC_WORKER_CHALLENGE_KEEP_HOURS=24

# --- Langfuse purge (E08, design/ADR-M53) ----------------------------------------
# The retention loop also deletes the model-call traces of purged intents in Langfuse, and sweeps
# Langfuse's raw OTLP files (every tenant) older than the hours below. Empty: up.sh sets
# http://langfuse-web:3000 when the profile observability is in the same call or Langfuse's
# ClickHouse volume exists, otherwise `off` (Langfuse not deployed: `project.purged` records
# `not_deployed`). A server that runs Langfuse sets it here (runbook T11 §5m). Mode: as above.
SDLC_WORKER_LANGFUSE_URL=
SDLC_WORKER_LANGFUSE_RAW_MAX_AGE_HOURS=24

# --- The index of project documents (X04 PR 3a, design/ADR-M89) ---------------------
# The worker's connection to knowledge-db, without a password (it comes from OpenBao,
# `kv/worker/knowledge-db`). Empty: up.sh sets postgresql://knowledge@knowledge-db:5432/knowledge
# when the profile knowledge is in the same call or knowledge-db's volume exists, otherwise `off`
# (a run with a `read_documents` tool then fails: `tool_unavailable`).
SDLC_WORKER_KNOWLEDGE_DB_URL=
