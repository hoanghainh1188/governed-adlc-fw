# Environment for platform/deploy/gpu-host/docker-compose.yml: vLLM on a separate GPU host (task
# L01 PR 2, design/ADR-M71 §4). Create it on the GPU host with:
#   pnpm gpu-host:env
# It holds no secret: the gateway's key is in SDLC_GPU_LINK_TLS_DIR (gpu-link/tls.sh).

COMPOSE_PROJECT_NAME=sdlc
# The GPU host's address that the platform server reaches (a LAN or VPN address). The gateway's
# port is published on this address only. Required; never 0.0.0.0 on a server.
SDLC_GPU_LINK_ADDR=
# The gateway's port: the same as SDLC_GPU_LINK_PORT in the platform's .env.
SDLC_GPU_LINK_PORT=8443
# The folder (outside the repository) with ca.pem, server.pem and server-key.pem: the gpu-host/
# folder of gpu-link/tls.sh issue, or the company CA's files (runbook T11 section 5d.2).
SDLC_GPU_LINK_TLS_DIR=
# The common name (CN) the platform's client certificate must hold. With a company CA, every
# other certificate of the company is refused.
SDLC_GPU_LINK_CLIENT_CN=sdlc-vllm-link
# Seconds the gateway waits for an answer from vllm (a long answer may take minutes).
SDLC_GPU_LINK_READ_TIMEOUT=600

# The model and its settings: the meaning of each is in the platform's .env.example ("Self-hosted
# model"). SDLC_VLLM_SERVED_NAME and SDLC_VLLM_MAX_NUM_SEQS must equal the platform's values.
SDLC_VLLM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
SDLC_VLLM_MODEL_REVISION=main
SDLC_VLLM_SERVED_NAME=qwen3-coder-30b-a3b-instruct
SDLC_VLLM_MAX_NUM_SEQS=4
SDLC_VLLM_MAX_MODEL_LEN=32768
SDLC_VLLM_GPU_MEMORY_UTILIZATION=0.90
SDLC_VLLM_GPU_COUNT=1
SDLC_VLLM_TOOL_PARSER=qwen3_coder
SDLC_VLLM_SHM_SIZE=8gb
